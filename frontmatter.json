{
  "$schema": "https://frontmatter.codes/config/config.schema.json",
  "frontMatter.dashboard.openOnStart": true,
  "frontMatter.framework.id": "next",
  "frontMatter.framework.startCommand": "npm run dev",
  "frontMatter.preview.host": "http://localhost:5173",
  "frontMatter.website.host": "https://patrick-project-journey.patrickbennett.chatgpt.site",
  "frontMatter.content.publicFolder": "public",
  "frontMatter.git.enabled": true,
  "frontMatter.git.commitMessage": "Opdater projektoversigt",
  "frontMatter.data.files": [
    {
      "id": "project-overview",
      "title": "Projektoversigt · Dansk og engelsk",
      "file": "[[workspace]]/content/projects.json",
      "labelField": "title",
      "fileType": "json",
      "singleEntry": false,
      "schema": {
        "title": "Projekt",
        "type": "object",
        "required": ["locale", "id", "index", "title", "category", "status", "progress", "accent", "summary", "now", "next", "destination", "milestones"],
        "properties": {
          "locale": {"title": "Sprog", "type": "string", "enum": ["da", "en"]},
          "id": {"title": "Teknisk ID", "type": "string"},
          "index": {"title": "Nummer", "type": "string"},
          "title": {"title": "Projektnavn", "type": "string"},
          "category": {"title": "Kategori og prioritet", "type": "string"},
          "status": {"title": "Kort status", "type": "string"},
          "progress": {"title": "Fremdrift i procent", "type": "number", "minimum": 0, "maximum": 100},
          "accent": {"title": "Accentfarve", "type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
          "summary": {"title": "Kort beskrivelse", "type": "string", "multiline": true},
          "now": {"title": "Hvor står projektet nu?", "type": "string", "multiline": true},
          "next": {"title": "Næste bevægelse", "type": "string", "multiline": true},
          "destination": {"title": "Målet på sigt", "type": "string", "multiline": true},
          "milestones": {"title": "Milepæle", "type": "array", "items": {"type": "string"}}
        }
      }
    }
  ]
}
